{
  "apiVersion": 3,
  "name": "series-manager/series-list",
  "title": "Series List",
  "category": "widgets",
  "supports": {
    "html": false
    },
  "icon": "list-view",
  "description": "Display series based on different modes.",
  "editorScript": "file:../../index.js",
  "style": "file:../../index.css",
  "editorStyle": "file:../../index.css",
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "mode": {
      "type": "string",
      "default": "all"
    },
    "limit": {
      "type": "number",
      "default": 5
    },
    "userId": {
      "type": "string",
      "default": ""
    }
  }
}


